{
  "name": "rl-gym-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A reproducible, experiment-first RL learning wiki.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "wiki:export": "node scripts/build.mjs --wiki",
    "wiki:sync": "node scripts/sync-wiki.mjs"
  }
}
